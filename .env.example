# Copy to .env and adjust. Every variable is optional.

# --- Configuration files --------------------------------------------------------------------
# JOBMATCH_TAXONOMY_FILE=configs/taxonomy.example.yaml
# JOBMATCH_POLICY_FILE=configs/policy.example.yaml

# --- Input limits ---------------------------------------------------------------------------
JOBMATCH_MAX_DOCUMENT_BYTES=1000000
JOBMATCH_MAX_DOCUMENTS=2000

# --- Optional model-written summaries -------------------------------------------------------
# llm_provider: none | openai | anthropic. The model only sees scores, counts and skill names,
# never names, contact details, employers or resume text.
JOBMATCH_LLM_PROVIDER=none
# JOBMATCH_OPENAI_API_KEY=
JOBMATCH_OPENAI_BASE_URL=https://api.openai.com/v1
JOBMATCH_OPENAI_CHAT_MODEL=gpt-4o-mini
# JOBMATCH_ANTHROPIC_API_KEY=
JOBMATCH_ANTHROPIC_BASE_URL=https://api.anthropic.com
JOBMATCH_ANTHROPIC_MODEL=claude-sonnet-5
JOBMATCH_ANTHROPIC_MAX_TOKENS=400

# --- HTTP and logging -----------------------------------------------------------------------
JOBMATCH_HTTP_TIMEOUT_SECONDS=30
JOBMATCH_RETRY_ATTEMPTS=3
JOBMATCH_RETRY_MIN_WAIT=0.5
JOBMATCH_RETRY_MAX_WAIT=8
JOBMATCH_LOG_LEVEL=WARNING
JOBMATCH_LOG_JSON=true
